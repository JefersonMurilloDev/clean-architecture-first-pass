{
  "watch": ["src"],
  "ext": ".ts,.js",
  "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts"],
  "exec": "ts-node ./src/app.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 500,
  "verbose": true,
  "restartable": "rs",
  "colours": true,
  "execMap": {
    "ts": "ts-node"
  },
  "runOnChangeOnly": false,
  "pollInterval": 300,
  "stdout": true
}
